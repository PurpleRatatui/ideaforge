# Server-only. Set one of these locally; use a server secret when publishing.
# Vercel AI Gateway can provide Jev without a direct TypeSafe account.
AI_GATEWAY_API_KEY=
# Optional direct TypeSafe route. If both keys are set, this takes precedence.
TYPESAFE_API_KEY=
# Server-only. Creates a fresh Hivemind project after each live roast, then asks
# Hivemind to improve the idea and write a GTM plan from that project context.
HIVEMIND_API_KEY=
# Optional override for private beta/staging endpoints.
HIVEMIND_API_BASE_URL=https://hivemind.myosin.xyz
